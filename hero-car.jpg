<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global TV - Ultra Premium</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.263.0/lucide.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap');
        
        :root {
            --primary: #ff3e3e;
            --accent: #6366f1;
            --bg-dark: #050505;
            --glass-bg: rgba(15, 15, 18, 0.75);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-dark);
            color: #ffffff;
        }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(25px) saturate(200%);
            -webkit-backdrop-filter: blur(25px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 62, 62, 0.3);
            transform: translateY(-2px);
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: var(--primary);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        .active-glow {
            box-shadow: 0 0 25px rgba(255, 62, 62, 0.25);
            border-left: 4px solid var(--primary) !important;
            background: linear-gradient(90deg, rgba(255, 62, 62, 0.15) 0%, transparent 100%) !important;
        }

        .sidebar-transition {
            transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .video-container {
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.9);
        }

        select {
            background-image: none !important;
        }

        option {
            background-color: #121214;
            color: white;
            padding: 10px;
        }
    </style>
</head>
<body class="overflow-hidden">
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-red-600/10 blur-[150px] rounded-full"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-indigo-600/10 blur-[150px] rounded-full"></div>
    </div>

    <div id="app" class="relative z-10 flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar-transition w-85 glass-panel flex flex-col overflow-hidden shrink-0 border-r border-white/5">
            <div class="p-8">
                <div class="flex items-center gap-4 mb-8">
                    <div class="relative">
                        <div class="w-12 h-12 bg-gradient-to-tr from-red-600 to-rose-400 rounded-2xl flex items-center justify-center shadow-lg shadow-red-600/30">
                            <i data-lucide="zap" class="text-white w-6 h-6 fill-white"></i>
                        </div>
                        <div class="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full border-2 border-[#09090b]"></div>
                    </div>
                    <div>
                        <h1 class="font-extrabold text-xl tracking-tight leading-none uppercase">Nova<span class="text-red-500 italic">Stream</span></h1>
                        <p class="text-[9px] text-zinc-500 font-bold tracking-[0.2em] uppercase mt-1">Sistem Televisi Global</p>
                    </div>
                </div>
                
                <div class="space-y-4">
                    <div class="relative group">
                        <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-500 group-focus-within:text-red-500 transition-colors"></i>
                        <input 
                            type="text" 
                            id="searchInput"
                            placeholder="Cari saluran..." 
                            class="w-full bg-white/5 border border-white/10 rounded-2xl py-3 pl-12 pr-4 text-sm focus:ring-2 focus:ring-red-500/20 focus:border-red-500/50 transition-all outline-none"
                        >
                    </div>

                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest ml-1">Filter Wilayah & Jenis</label>
                        <div class="flex flex-col gap-2">
                            <!-- Dropdown Negara -->
                            <div class="relative w-full">
                                <select id="countryFilter" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-4 pr-10 text-[11px] appearance-none cursor-pointer hover:bg-white/10 transition-all outline-none focus:border-red-500/50">
                                    <option value="All">🌏 Semua Wilayah</option>
                                </select>
                                <i data-lucide="map" class="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-500 pointer-events-none"></i>
                            </div>
                            
                            <!-- Dropdown Kategori -->
                            <div class="relative w-full">
                                <select id="categoryFilter" class="w-full bg-white/5 border border-white/10 rounded-xl py-3 pl-4 pr-10 text-[11px] appearance-none cursor-pointer hover:bg-white/10 transition-all outline-none focus:border-red-500/50">
                                    <option value="All">🏷️ Semua Kategori</option>
                                </select>
                                <i data-lucide="tag" class="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-500 pointer-events-none"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="channelList" class="flex-1 overflow-y-auto custom-scrollbar px-4 pb-4 space-y-2">
                <!-- Saluran dimuat di sini -->
            </div>

            <div class="p-6 mt-auto border-t border-white/5 bg-white/2">
                <div class="flex items-center justify-between text-[10px] text-zinc-500 font-bold uppercase tracking-widest">
                    <span id="channelCount">0 SALURAN</span>
                    <span class="text-green-500 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span> ONLINE</span>
                </div>
            </div>
        </aside>

        <main class="flex-1 flex flex-col relative overflow-hidden">
            <header class="absolute top-0 left-0 right-0 h-24 flex items-center justify-between px-10 z-50 pointer-events-none">
                <button id="toggleSidebar" class="p-3 glass-panel rounded-2xl hover:bg-red-600 transition-all shadow-2xl pointer-events-auto active:scale-95 group">
                    <i data-lucide="menu" id="toggleIcon" class="w-6 h-6 group-hover:scale-110 transition-transform"></i>
                </button>
            </header>

            <div class="flex-1 flex flex-col">
                <div id="playerContainer" class="flex-1 flex flex-col items-center justify-center p-6 md:p-12 relative">
                    <div id="welcomeScreen" class="text-center relative">
                        <div class="animate-float mb-12">
                            <div class="w-40 h-40 bg-gradient-to-b from-white/5 to-transparent rounded-[3rem] border border-white/10 flex items-center justify-center mx-auto shadow-inner">
                                <i data-lucide="clapperboard" size="64" class="text-red-500/30"></i>
                            </div>
                        </div>
                        <h2 class="text-5xl font-extrabold mb-6 tracking-tighter leading-tight">
                            Televisi Masa Depan <br/>
                            <span class="bg-gradient-to-r from-red-500 to-indigo-500 bg-clip-text text-transparent italic">Global Streaming.</span>
                        </h2>
                        <p class="text-zinc-500 max-w-md mx-auto leading-relaxed text-sm font-medium">
                            Akses ribuan saluran internasional secara langsung. Pilih saluran dari daftar di samping untuk memulai.
                        </p>
                    </div>
                </div>

                <div id="metadataArea" class="hidden px-10 pb-10">
                    <div class="glass-panel p-8 rounded-[2.5rem] flex flex-col lg:flex-row items-center justify-between gap-8 shadow-3xl border border-white/10">
                        <div class="flex items-center gap-8">
                            <div id="currentLogo" class="w-24 h-24 bg-white/5 rounded-3xl flex items-center justify-center p-4 ring-1 ring-white/10 overflow-hidden shadow-2xl backdrop-blur-sm"></div>
                            <div>
                                <div class="flex items-center gap-4 mb-3">
                                    <h2 id="currentName" class="text-3xl md:text-4xl font-extrabold tracking-tighter uppercase italic">CHANNEL</h2>
                                    <span class="flex items-center gap-2 bg-red-600 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest animate-pulse">
                                        <span class="w-1.5 h-1.5 bg-white rounded-full"></span> LIVE
                                    </span>
                                </div>
                                <div class="flex flex-wrap items-center gap-6 text-zinc-400">
                                    <div class="flex items-center gap-2">
                                        <div class="p-1.5 rounded-lg bg-zinc-800"><i data-lucide="map-pin" class="w-4 h-4 text-red-500"></i></div>
                                        <span id="currentCountry" class="text-xs font-bold uppercase tracking-wider">WILAYAH</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="p-1.5 rounded-lg bg-zinc-800"><i data-lucide="tag" class="w-4 h-4 text-indigo-500"></i></div>
                                        <span id="currentCategory" class="text-xs font-bold uppercase tracking-wider">KATEGORI</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        let allChannels = [];
        let isSidebarOpen = true;
        let selectedId = null;
        let hlsPlayer = null;
        const STREAM_SOURCE = "https://iptv-org.github.io/iptv/index.m3u";

        const elements = {
            channelList: document.getElementById('channelList'),
            searchInput: document.getElementById('searchInput'),
            countryFilter: document.getElementById('countryFilter'),
            categoryFilter: document.getElementById('categoryFilter'),
            sidebar: document.getElementById('sidebar'),
            toggleSidebar: document.getElementById('toggleSidebar'),
            toggleIcon: document.getElementById('toggleIcon'),
            playerContainer: document.getElementById('playerContainer'),
            metadataArea: document.getElementById('metadataArea'),
            welcomeScreen: document.getElementById('welcomeScreen'),
            channelCount: document.getElementById('channelCount')
        };

        const updateIcons = () => { if (window.lucide) window.lucide.createIcons(); };

        const fetchChannels = async () => {
            elements.channelList.innerHTML = `<div class="p-10 text-center text-[10px] font-bold tracking-widest animate-pulse uppercase">Memuat Database Saluran...</div>`;
            try {
                const response = await fetch(STREAM_SOURCE);
                const text = await response.text();
                parseM3U(text);
            } catch (error) {
                elements.channelList.innerHTML = `<div class="p-10 text-center text-red-500 text-xs font-bold uppercase">Gagal memuat saluran. Periksa koneksi Anda.</div>`;
            }
        };

        const parseM3U = (data) => {
            const lines = data.split('\n');
            const result = [];
            let currentItem = {};

            lines.forEach(line => {
                line = line.trim();
                if (line.startsWith('#EXTINF:')) {
                    const nameMatch = line.match(/,(.*)$/);
                    const logoMatch = line.match(/tvg-logo="([^"]*)"/);
                    const groupMatch = line.match(/group-title="([^"]*)"/);
                    
                    currentItem.name = nameMatch ? nameMatch[1].trim() : "Tanpa Nama";
                    currentItem.logo = logoMatch ? logoMatch[1] : null;
                    
                    // Ekstraksi negara dari group-title atau default
                    let rawGroup = groupMatch ? groupMatch[1] : "International";
                    // Bersihkan tag group
                    currentItem.country = rawGroup.split(';')[0].replace(/[\[\]]/g, '').trim();
                    currentItem.category = "General";
                } else if (line.startsWith('http')) {
                    currentItem.url = line;
                    if (currentItem.name && !currentItem.name.includes("???")) {
                        result.push({ ...currentItem, id: Math.random().toString(36).substr(2, 9) });
                    }
                    currentItem = {};
                }
            });

            allChannels = result.sort((a, b) => a.name.localeCompare(b.name));
            initFilters();
            renderChannels(allChannels.slice(0, 100));
        };

        const initFilters = () => {
            // Filter Negara
            const countryMap = {};
            allChannels.forEach(ch => {
                countryMap[ch.country] = (countryMap[ch.country] || 0) + 1;
            });

            const sortedCountries = Object.keys(countryMap).sort();
            
            elements.countryFilter.innerHTML = '<option value="All">🌏 Semua Wilayah</option>';
            sortedCountries.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c;
                opt.textContent = `${c} (${countryMap[c]})`;
                elements.countryFilter.appendChild(opt);
            });

            // Filter Kategori (Estimasi berdasarkan nama/grup)
            const categories = ["News", "Sports", "Movies", "Music", "Kids", "Documentary", "Religious", "Entertainment"];
            elements.categoryFilter.innerHTML = '<option value="All">🏷️ Semua Kategori</option>';
            categories.forEach(cat => {
                const opt = new Option(cat, cat);
                elements.categoryFilter.add(opt);
            });
        };

        const renderChannels = (channels) => {
            elements.channelList.innerHTML = '';
            elements.channelCount.textContent = `${channels.length} SALURAN`;
            
            if (channels.length === 0) {
                elements.channelList.innerHTML = `<div class="p-10 text-center text-zinc-600 text-[10px] font-bold uppercase tracking-widest">Saluran tidak ditemukan</div>`;
                return;
            }

            const frag = document.createDocumentFragment();
            channels.forEach(ch => {
                const isActive = selectedId === ch.id;
                const card = document.createElement('div');
                card.className = `glass-card group cursor-pointer p-3.5 rounded-2xl flex items-center gap-4 ${isActive ? 'active-glow' : ''}`;
                
                card.onclick = () => {
                    selectedId = ch.id;
                    renderChannels(channels);
                    playChannel(ch);
                };

                const logo = ch.logo 
                    ? `<img src="${ch.logo}" class="w-full h-full object-contain p-1" onerror="this.src='https://placehold.co/40x40/18181b/white?text=TV'">`
                    : `<i data-lucide="tv" class="text-zinc-600 w-4 h-4"></i>`;

                card.innerHTML = `
                    <div class="w-12 h-12 bg-white/5 rounded-xl overflow-hidden flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                        ${logo}
                    </div>
                    <div class="flex-1 overflow-hidden">
                        <h4 class="text-xs font-bold truncate ${isActive ? 'text-red-500' : 'text-zinc-100'}">${ch.name}</h4>
                        <p class="text-[9px] font-bold text-zinc-500 uppercase tracking-tighter mt-1">${ch.country}</p>
                    </div>
                    <div class="w-1.5 h-1.5 rounded-full ${isActive ? 'bg-red-500' : 'bg-zinc-800'}"></div>
                `;
                frag.appendChild(card);
            });
            elements.channelList.appendChild(frag);
            updateIcons();
        };

        const playChannel = (ch) => {
            if (hlsPlayer) {
                hlsPlayer.destroy();
                hlsPlayer = null;
            }

            elements.welcomeScreen.classList.add('hidden');
            elements.metadataArea.classList.remove('hidden');
            
            document.getElementById('currentName').textContent = ch.name;
            document.getElementById('currentCountry').textContent = ch.country;
            document.getElementById('currentCategory').textContent = ch.category;
            document.getElementById('currentLogo').innerHTML = ch.logo 
                ? `<img src="${ch.logo}" class="max-w-full max-h-full object-contain" onerror="this.src='https://placehold.co/80x80/18181b/white?text=TV'">`
                : `<i data-lucide="monitor" class="w-10 h-10 text-zinc-800"></i>`;

            elements.playerContainer.innerHTML = `
                <div class="w-full max-w-6xl aspect-video glass-panel rounded-[3rem] overflow-hidden shadow-3xl video-container group relative bg-black">
                    <video id="videoPlayer" controls autoplay class="w-full h-full"></video>
                </div>
            `;

            const video = document.getElementById('videoPlayer');
            
            if (Hls.isSupported()) {
                hlsPlayer = new Hls({
                    enableWorker: true,
                    lowLatencyMode: true,
                    backBufferLength: 90
                });
                
                hlsPlayer.loadSource(ch.url);
                hlsPlayer.attachMedia(video);
                
                hlsPlayer.on(Hls.Events.ERROR, (event, data) => {
                    if (data.fatal) {
                        switch (data.type) {
                            case Hls.ErrorTypes.NETWORK_ERROR:
                                hlsPlayer.startLoad();
                                break;
                            case Hls.ErrorTypes.MEDIA_ERROR:
                                hlsPlayer.recoverMediaError();
                                break;
                            default:
                                hlsPlayer.destroy();
                                break;
                        }
                    }
                });
            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = ch.url;
            }
            updateIcons();
        };

        const filterData = () => {
            const query = elements.searchInput.value.toLowerCase();
            const country = elements.countryFilter.value;
            const category = elements.categoryFilter.value;

            const filtered = allChannels.filter(ch => {
                const matchSearch = ch.name.toLowerCase().includes(query);
                const matchCountry = country === 'All' || ch.country === country;
                const matchCategory = category === 'All' || ch.name.toLowerCase().includes(category.toLowerCase());
                return matchSearch && matchCountry && matchCategory;
            });

            renderChannels(filtered.slice(0, 100));
        };

        elements.searchInput.oninput = filterData;
        elements.countryFilter.onchange = filterData;
        elements.categoryFilter.onchange = filterData;

        elements.toggleSidebar.onclick = () => {
            isSidebarOpen = !isSidebarOpen;
            elements.sidebar.style.width = isSidebarOpen ? '21.25rem' : '0';
            elements.toggleIcon.setAttribute('data-lucide', isSidebarOpen ? 'x' : 'menu');
            updateIcons();
        };

        window.onload = () => {
            updateIcons();
            fetchChannels();
        };
    </script>
</body>
</html>