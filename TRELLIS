        ];

        function showPage(id) {
            document.querySelectorAll('.page').forEach(p => {
                p.classList.remove('active');
            });
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            
            setTimeout(() => {
                const target = document.getElementById('page-' + id);
                if (target) {
                    target.classList.add('active');
                }
            }, 50);

            document.getElementById('btn-' + id).classList.add('active');
            window.scrollTo({top: 0, behavior: 'smooth'});
        }

        function buildFilters() {
            const filtersContainer = document.getElementById('project-filters');
            if (!filtersContainer) return;

            const tags = ['Semua', ...new Set(projects.map(p => p.tag))];
            
            filtersContainer.innerHTML = tags.map(tag => {
                const isActive = tag === 'Semua';
                return `
                    <button onclick="handleFilterClick(this, '${tag}')" class="filter-btn px-6 py-2.5 rounded-full border border-white/10 text-[10px] font-bold uppercase tracking-widest transition-all duration-300 ${isActive ? 'bg-amber-500 text-black border-transparent shadow-[0_0_20px_rgba(242,186,66,0.3)]' : 'bg-white/5 text-stone-400 hover:text-white hover:bg-white/10'} interactive">
                        ${tag}
                    </button>
                `;
            }).join('');
        }

        function handleFilterClick(button, tag) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-amber-500', 'text-black', 'border-transparent', 'shadow-[0_0_20px_rgba(242,186,66,0.3)]');
                btn.classList.add('bg-white/5', 'text-stone-400');
            });
            button.classList.add('bg-amber-500', 'text-black', 'border-transparent', 'shadow-[0_0_20px_rgba(242,186,66,0.3)]');
            button.classList.remove('bg-white/5', 'text-stone-400');

            const grid = document.getElementById('full-koleksi-grid');
            grid.style.opacity = '0';
            grid.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                renderProjects(tag);
                grid.style.transition = 'all 0.5s ease';
                grid.style.opacity = '1';
                grid.style.transform = 'translateY(0)';
            }, 300);
        }

        function renderProjects(filter) {
            const grid = document.getElementById('full-koleksi-grid');
            if (!grid) return;
            const filtered = filter === 'Semua' ? projects : projects.filter(p => p.tag === filter);
            grid.innerHTML = filtered.map(p => `
                <a href="${p.link}" target="_blank" class="glass-panel p-5 rounded-[36px] group block interactive transition-all duration-500 hover:-translate-y-3 hover:border-amber-500/40 hover:shadow-[0_20px_40px_rgba(0,0,0,0.5)] flex flex-col h-full relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-b from-amber-500/0 to-amber-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="aspect-[4/3] rounded-[24px] overflow-hidden mb-6 bg-black/50 relative z-10 border border-white/5">
                        <img src="${p.img}" class="w-full h-full object-cover grayscale opacity-70 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" onerror="this.onerror=null;this.src='https://placehold.co/600x450/111111/f2ba42?text=${encodeURIComponent(p.title)}'">
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent flex items-end p-6 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                            <span class="text-white text-[11px] font-black uppercase tracking-widest flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full">Explore <i class="fa-solid fa-arrow-right text-amber-500"></i></span>
                        </div>
                    </div>
                    <div class="px-2 flex-grow flex flex-col z-10">
                        <span class="text-[9px] font-black text-amber-500 tracking-[0.25em] uppercase mb-2 inline-block">${p.tag}</span>
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-amber-500 transition-colors">${p.title}</h3>
                        <p class="text-stone-400 text-sm font-light leading-relaxed mt-auto">${p.desc}</p>
                    </div>
                </a>
            `).join('');
        }

        function submitContactForm() {
            const name = document.getElementById('contact-name').value.trim();
            const email = document.getElementById('contact-email').value.trim();
            const message = document.getElementById('contact-message').value.trim();
            const responseBox = document.getElementById('form-response');

            if (!name || !email || !message) {
                responseBox.className = "text-xs text-center font-bold tracking-wider py-4 uppercase rounded-2xl bg-red-500/10 text-red-400 mt-6 border border-red-500/20 shadow-[0_0_15px_rgba(239,68,68,0.1)] transition-all duration-300 relative z-10";
                responseBox.innerText = "Harap isi semua kolom formulir!";
                responseBox.classList.remove('hidden');
                return;
            }

            responseBox.className = "text-xs text-center font-bold tracking-wider py-4 uppercase rounded-2xl bg-amber-500/10 text-amber-500 mt-6 animate-pulse border border-amber-500/20 transition-all duration-300 relative z-10";
            responseBox.innerText = "Mengirim pesan...";
            responseBox.classList.remove('hidden');

            setTimeout(() => {
                responseBox.className = "text-xs text-center font-bold tracking-wider py-4 uppercase rounded-2xl bg-emerald-500/10 text-emerald-400 mt-6 border border-emerald-500/20 shadow-[0_0_15px_rgba(16,185,129,0.1)] transition-all duration-300 relative z-10";
                responseBox.innerText = `Terima kasih, ${name}! Pesan berhasil dikirim.`;
                document.getElementById('contact-name').value = '';
                document.getElementById('contact-email').value = '';
                document.getElementById('contact-message').value = '';
            }, 1500);
        }

        function initRain() {
            const canvas = document.getElementById('rain-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let width, height;
            let drops = [];

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            class Drop {
                constructor() {
                    this.reset(true);
                }
                reset(initial = false) {
                    this.x = Math.random() * width;
                    this.y = initial ? Math.random() * height : (Math.random() * -100) - 20; 
                    this.vy = 12 + Math.random() * 15; 
                    this.vx = -1.5 - Math.random() * 2.5; 
                    this.len = 20 + Math.random() * 30; 
                    this.opacity = 0.1 + Math.random() * 0.25; 
                    this.weight = 0.8 + Math.random() * 1.2; 
                }
                update() {
                    this.y += this.vy;
                    this.x += this.vx;
                    if (this.y > height + 50 || this.x < -50) {
                        this.reset();
                    }
                }
                draw() {
                    ctx.beginPath();
                    // Warna hujan diubah menjadi pantulan matahari pagi (emas pucat/jingga terang)
                    ctx.strokeStyle = `rgba(255, 215, 140, ${this.opacity})`; 
                    ctx.lineWidth = this.weight;
                    ctx.lineCap = 'round';
                    ctx.moveTo(this.x, this.y);
                    ctx.lineTo(this.x + (this.vx * 0.5), this.y + this.len);
                    ctx.stroke();
                }
            }

            const maxDrops = 150; 
            for (let i = 0; i < maxDrops; i++) {
                drops.push(new Drop());
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);
                drops.forEach(drop => {
                    drop.update();
                    drop.draw();
                });
                requestAnimationFrame(animate);
            }
            animate();
        }

        function init() {
            const skillGrid = document.getElementById('skills-container');
            if (skillGrid) {
                skillGrid.innerHTML = skills.map(s => `
                    <div class="skill-card group interactive">
                        <div class="skill-icon-box">
                            <i class="${s.icon}"></i>
                        </div>
                        <h3 class="text-2xl font-black text-white mb-5 uppercase tracking-tight group-hover:text-amber-500 transition-colors">${s.name}</h3>
                        <p class="text-stone-400 font-light leading-relaxed text-sm">${s.desc}</p>
                    </div>
                `).join('');
            }
            buildFilters();
            renderProjects('Semua');
            initRain();
        }

        window.onload = function() {
            init();
        };
    </script>
</body>
</html>