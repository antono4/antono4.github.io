    <style>
        :root {
            --primary: #f2ba42;
            --primary-rgb: 242, 186, 66;
            --bg-dark: #070707;
            --card-bg: rgba(255, 255, 255, 0.02);
            --card-border: rgba(255, 255, 255, 0.05);
            --glass-highlight: rgba(255, 255, 255, 0.05);
        }

        * {
            cursor: auto !important;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        a, button, .interactive, input, textarea {
            cursor: pointer !important;
        }

        body {
            background-color: var(--bg-dark);
            color: #fafaf9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            overflow-x: hidden;
            min-height: 100vh;
        }

        h1, h2, h3, h4 { font-family: 'Sora', sans-serif; }

        .bg-wrapper {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: -1;
            /* Latar belakang dengan semburat hangat dari sudut kanan atas */
            background: radial-gradient(ellipse at top right, #2a180b 0%, #0d0a08 50%, #050505 100%);
            overflow: hidden;
        }

        /* Pendaran Cahaya Matahari Pagi */
        .morning-sun {
            position: absolute;
            top: -20%;
            right: -10%;
            width: 70vw;
            height: 70vw;
            background: radial-gradient(circle, rgba(242, 186, 66, 0.15) 0%, rgba(255, 120, 30, 0.05) 40%, transparent 70%);
            border-radius: 50%;
            filter: blur(50px);
            animation: pulseSun 8s infinite alternate ease-in-out;
            z-index: 1;
        }

        /* Efek Sinar (God Rays) */
        .sun-rays {
            position: absolute;
            top: 0; right: 0;
            width: 100%; height: 100%;
            background: repeating-linear-gradient(
                -45deg,
                rgba(242, 186, 66, 0.03) 0%,
                rgba(242, 186, 66, 0.01) 3%,
                transparent 3%,
                transparent 8%
            );
            mask-image: radial-gradient(ellipse at top right, black 0%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse at top right, black 0%, transparent 70%);
            z-index: 1;
            pointer-events: none;
            animation: rotateRays 60s linear infinite;
            transform-origin: top right;
        }

        @keyframes pulseSun {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.05); opacity: 1; }
        }

        @keyframes rotateRays {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(5deg); }
        }

        .mesh-gradient {
            position: absolute;
            width: 100%; height: 100%;
            background-image: 
                radial-gradient(at 0% 0%, rgba(242, 186, 66, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(200, 80, 20, 0.05) 0px, transparent 50%);
            filter: blur(100px);
            z-index: 2;
        }

        #rain-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 3; /* Hujan di depan matahari */
        }

        .floating-nav {
            position: fixed;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            background: rgba(10, 10, 10, 0.65);
            backdrop-filter: blur(24px) saturate(200%);
            -webkit-backdrop-filter: blur(24px) saturate(200%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding: 8px;
            border-radius: 99px;
            display: flex;
            gap: 4px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), 
                        0 8px 24px rgba(0,0,0,0.4),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            width: max-content;
            max-width: 92vw;
            overflow-x: auto;
        }

        .nav-btn {
            padding: 12px 24px;
            border-radius: 99px;
            color: #78716c;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }

        .nav-btn::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: var(--primary);
            opacity: 0;
            border-radius: 99px;
            transition: opacity 0.4s ease;
            z-index: -1;
        }

        .nav-btn:hover {
            color: #fafaf9;
            background: rgba(255, 255, 255, 0.05);
        }

        .nav-btn.active {
            color: #000;
            box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.25);
        }

        .nav-btn.active::before {
            opacity: 1;
        }

        .hero-title {
            font-size: clamp(3rem, 11vw, 8.5rem);
            line-height: 0.9;
            letter-spacing: -0.05em;
        }

        .outline-text {
            color: transparent;
            -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.25);
            text-shadow: none;
        }

        .skill-card, .glass-panel {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.005) 100%);
            border: 1px solid var(--card-border);
            border-top: 1px solid var(--glass-highlight);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.7);
        }

        .skill-card {
            border-radius: 32px;
            padding: 48px 40px;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .skill-card::after {
            content: '';
            position: absolute;
            top: 0; left: -100%; width: 50%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
            transform: skewX(-20deg);
            transition: 0.7s;
        }

        .skill-card:hover::after {
            left: 200%;
        }

        .skill-card:hover {
            transform: translateY(-12px) scale(1.02);
            border-color: rgba(var(--primary-rgb), 0.3);
            box-shadow: 0 30px 60px -15px rgba(var(--primary-rgb), 0.15),
                        0 20px 40px -10px rgba(0, 0, 0, 0.7);
